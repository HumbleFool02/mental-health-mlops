FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Copy production requirements
COPY requirements.production.txt .

# Install Python packages (awscli is needed for the model download step below)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.production.txt && \
    pip install --no-cache-dir "awscli>=1.32,<2"

# ---------------------------------------------------------------------------
# Model download from S3
# Credentials are passed as build args, promoted to ENV so the AWS CLI can
# read them, used for the sync, then cleared.  Note: clearing ENV vars does
# NOT remove the values from the intermediate build-layer history — anyone
# who can inspect the image layers could read them.  Keep the built image
# in a private registry (GHCR) and rotate credentials if they are leaked.
# ---------------------------------------------------------------------------
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_DEFAULT_REGION=us-east-1

ENV AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID \
    AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY \
    AWS_DEFAULT_REGION=$AWS_DEFAULT_REGION

RUN aws s3 sync s3://mental-health-mlops-models/distilbert_exp2/ ./models/distilbert_exp2/

# Unset credentials so they are absent from the running container's environment
ENV AWS_ACCESS_KEY_ID="" \
    AWS_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Application code (after model download — changes here won't bust the S3 layer)
# ---------------------------------------------------------------------------
COPY src/ ./src/
COPY data/processed/ ./data/processed/

# src/api uses bare module imports (model_loader, predictor, schemas).
# Adding src/api to PYTHONPATH lets Python resolve them when the app is
# launched as the dotted module path src.api.app from WORKDIR /app.
ENV PYTHONPATH=/app/src/api

# Directory for the SQLite drift database written at runtime
RUN mkdir -p data

EXPOSE 8000 8501

CMD ["sh", "-c", "uvicorn src.api.app:app --host 0.0.0.0 --port 8000 & streamlit run src/dashboard/drift_dashboard.py --server.port 8501 --server.address 0.0.0.0"]
